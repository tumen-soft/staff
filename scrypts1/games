declare -i i=0;
declare -i j=0;
declare -i I=0;
g=(A B C D E F G H I J K L)
for num in {1..100000};
do
i=0;
clear;
echo -e '\e[1;97;40m' Доступные игры: '\e[0m';
for s in ${f[*]}; 
do
if [ $i == $j ];
then 
echo -e '\e[1;30;42m' ${g[$i]} '\e[0m' '\e[1;30;42m'$s'\e[0m' ;
else
echo -e '\e[1;30;42m' ${g[$i]} '\e[0m' $s;
fi
