done
read -sN1 
    #echo "${REPLY}";
    case "${REPLY}" in
      A) j=j-1;i=0;;
      B) j=j+1;i=0;;
      " ")
I=0;
for h in ${f[*]}; 
do
if [ $((I - j)) == 0 ];
then 

offline $h 

fi
I=I+1
done
    ;;
  esac
done
}
export -f игры


